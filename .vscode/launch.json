{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Launch FaciesGAN (debugpy)",
      "type": "debugpy",
      "request": "launch",
      "module": "torch.distributed.run",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "subProcess": true,
      "redirectOutput": false,
      "preLaunchTask": "start-training-env",
      "env": {
        "OMP_NUM_THREADS": "1",
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "TORCH_LOGS": "-dynamo,-inductor",
        "TORCHDYNAMO_VERBOSE": "0",
        "TRITON_VERBOSE": "0",
        "TRITON_PRINT_AUTOTUNING": "0",
        "TORCH_COMPILE_DEBUG": "0",
        "TORCHINDUCTOR_COMPILE_THREADS": "16",
        "TORCHINDUCTOR_AUTOTUNE_NUM_CHOICES_DISPLAYED": "0",
        "TORCHINDUCTOR_MAX_AUTOTUNE_REPORT_CHOICES_STATS": "0",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1",
        "CUDA_LAUNCH_BLOCKING": "1",
        "TORCH_USE_CUDA_DSA": "1",
        "PYTHONUNBUFFERED": "1"
      },
      "args": [
        "--nproc_per_node=2",
        "main.py",
        "--input-path",
        "data",
        "--output-path",
        "outputs/py/",
        "--num-train-pyramids",
        "200",
        "--batch-size",
        "40",
        "--num-workers",
        "2",
        "--num-iter",
        "1000",
        "--num-parallel-scales",
        "7",
        "--discriminator-steps",
        "3",
        "--generator-steps",
        "3",
        "--reconstruction-loss-penalty",
        "10",
        "--scale0-noise-amp",
        "1.5",
        "--gradient-loss-penalty",
        "20.0",
        "--scale0-disc-grad-clip",
        "25.0",
        "--scale0-gp-alpha",
        "50.0",
        "--min-noise-amp",
        "0.1",
        "--use-gradnorm",
        "--gradnorm-interval",
        "1",
        "--use-wells",
        "--use-seismic",
        "--compile-backend"
      ]
    },
    {
      "name": "Python: Attach FaciesGAN (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ],
      "justMyCode": false
    },
    {
      "name": "Python: Train Neural Smoothers",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/train_neural_smoothers.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
      },
      "args": [
        "--facies",
        "--rock-physics",
        "--epochs",
        "2000",
        "--lr",
        "3e-4"
      ]
    },
    {
      "name": "Python: Experiments (Ablation)",
      "type": "debugpy",
      "request": "launch",
      "module": "experiments",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "preLaunchTask": "start-tensorboard",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "TORCH_LOGS": "-dynamo,-inductor",
        "TORCHDYNAMO_VERBOSE": "0",
        "TRITON_VERBOSE": "0",
        "TRITON_PRINT_AUTOTUNING": "0",
        "TORCH_COMPILE_DEBUG": "0",
        "TORCHINDUCTOR_COMPILE_THREADS": "16",
        "TORCHINDUCTOR_AUTOTUNE_NUM_CHOICES_DISPLAYED": "0",
        "TORCHINDUCTOR_MAX_AUTOTUNE_REPORT_CHOICES_STATS": "0",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "NCCL_IB_DISABLE": "1",
        "TORCH_DISTRIBUTED_DEBUG": "OFF",
        "OMP_NUM_THREADS": "12",
        "MKL_NUM_THREADS": "12",
        "OPENBLAS_NUM_THREADS": "12",
        "NUMEXPR_NUM_THREADS": "12",
        "NUMBA_NUM_THREADS": "12",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "0",
        "CUDA_LAUNCH_BLOCKING": "0",
        "TORCH_USE_CUDA_DSA": "0",
        "PYTHONUNBUFFERED": "1"
      },
      "args": [
        "--stop-scale", "4",
        "--crop-size", "256",
        "--min-size", "20",
        "--manual-seed", "42",
        "--num-real-facies", "4",
        "--use-rock-physics",
        "--use-seismic",
        "--use-wells",
        // "--no-compile",
        "--input-path", "data",
        "--output-path", "outputs/experiments",
        "--how-many", "1000",
        "--num-iter", "2000",
        "--num-train-pyramids", "200",
        "--batch-size", "25",
        "--num-workers", "4",
        "--prefetch-factor", "4",
        "--num-parallel-scales", "5",
        "--nproc-per-node", "2",
        
        "--lr-d", "5e-4",
        "--lr-g", "5e-4",
        "--scheduler-g", "step",
        "--scheduler-d", "step",
        "--lr-min", "5e-5",
        "--lr-decay", "99999",
        // "--lr-patience", "2000",
        "--lr-g-factor", "0.7",
        "--lr-d-factor", "0.8",

        "--scale0-disc-lr-factor", "1.0",
        "--scale0-disc-grad-clip", "5.0",
        "--scale0-loss-multiplier", "1.0",
        "--scale0-noise-amp", "0.6",
        "--scale0-gradient-loss-penalty", "10.0",
        "--scale0-disc-steps-multiplier", "1",
        "--discriminator-steps", "2",
        "--generator-steps", "4",

        "--diversity-loss-penalty", "2.0",
        "--adversarial-loss-penalty", "1.0",
        "--gradient-loss-penalty", "10.0",
        "--rec-facies-loss-penalty", "10.0",
        "--well-loss-penalty", "15.0",
        "--rec-rock-physics-loss-penalty", "10.0",
        "--tv-loss-penalty", "5e-3",
        "--elastic-loss-penalty", "2.0",
        "--seismic-loss-penalty", "0.5",

        "--dz-pixel", "0.5",
        "--wavelet-f-peak", "26.0",
        "--wavelet-dt", "0.001",
        "--grad-clip-norm", "10.0",
        "--num-diversity-samples", "5",
        "--gp-interval", "8",
        "--min-noise-amp", "0.15",
        "--use-gradnorm",
        "--gradnorm-alpha", "0.3",

        "--time-unit", "step",
        "--gradnorm-interval", "25",
        "--checkpoint-interval", "500",
        "--save-interval", "200",

        "--seismic-stretch-percentile", "98",
        "--vp-vs-robust-range",
        "--no-plot-outputs",
        "--variants", "wells_only"
       
      ]
    },
    {
      "name": "Python: Experiments (Generate + Comparisons)",
      "type": "debugpy",
      "request": "launch",
      "module": "experiments",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "OMP_NUM_THREADS": "1",
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "TORCH_LOGS": "-dynamo,-inductor",
        "TORCHDYNAMO_VERBOSE": "0",
        "TRITON_VERBOSE": "0",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1",
        "TRITON_PRINT_AUTOTUNING": "0",
        "TORCH_COMPILE_DEBUG": "0",
        "TORCHINDUCTOR_COMPILE_THREADS": "16",
        "TORCHINDUCTOR_AUTOTUNE_NUM_CHOICES_DISPLAYED": "0",
        "TORCHINDUCTOR_MAX_AUTOTUNE_REPORT_CHOICES_STATS": "0"
      },
      "args": [
        "--skip-training",
        "--model-paths",
        "outputs/experiments/wells_seismic",
        "outputs/experiments/wells_only",
        "outputs/experiments/seismic_only",
        "outputs/experiments/unconditional",
        "--use-rock-physics",
        "--input-path", "data",
        "--output-path", "outputs/experiments",
        "--embedding-methods", "isomap", "mds", "tsne", "umap",
        "--embedding-data", "facies", "rock_physics",
        "--num-iter", "100",
        "--nproc-per-node", "2",
        "--how-many", "1000",
        "--no-tensorboard"
      ]
    }
  ],
  "inputs": [
    {
      "id": "howMany",
      "type": "promptString",
      "description": "How many facies to generate?",
      "default": "10"
    }
  ]
}
