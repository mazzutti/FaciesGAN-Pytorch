{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Launch FaciesGAN (debugpy)",
      "type": "debugpy",
      "request": "launch",
      "module": "torch.distributed.run",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "subProcess": true,
      "redirectOutput": true,
      "preLaunchTask": "start-training-env",
      "env": {
        "OMP_NUM_THREADS": "1",
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1",
        "CUDA_LAUNCH_BLOCKING": "1",
        "TORCH_USE_CUDA_DSA": "1"
      },
      "args": [
        "--nproc_per_node=2",
        "main.py",
        "--input-path",
        "data",
        "--output-path",
        "outputs/py/",
        "--num-train-pyramids",
        "200",
        "--batch-size",
        "40",
        "--num-workers",
        "2",
        "--num-iter",
        "1000",
        "--num-parallel-scales",
        "7",
        "--discriminator-steps",
        "3",
        "--generator-steps",
        "3",
        "--reconstruction-loss-penalty",
        "10",
        "--scale0-noise-amp",
        "1.5",
        "--min-noise-amp",
        "0.3",
        "--use-wells",
        "--use-seismic",
        "--compile-backend"
      ]
    },
    {
      "name": "Python: Attach FaciesGAN (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ],
      "justMyCode": false
    },
    {
      "name": "Python: Train Neural Smoothers",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/train_neural_smoothers.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
      },
      "args": [
        "--facies",
        "--rock-physics",
        "--epochs",
        "2000",
        "--lr",
        "3e-4"
      ]
    },
    {
      "name": "Python: Experiments (Ablation)",
      "type": "debugpy",
      "request": "launch",
      "module": "experiments",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "preLaunchTask": "start-tensorboard",
      "env": {
        "OMP_NUM_THREADS": "1",
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1",
        "CUDA_LAUNCH_BLOCKING": "1",
        "TORCH_USE_CUDA_DSA": "1"
      },
      "args": [
        "--use-rock-physics",
        "--use-seismic",
        "--use-wells",
        "--compile-backend",
        "--no-compile",
        "--input-path", "data",
        "--output-path", "outputs/experiments",
        "--how-many", "10",
        "--num-iter", "10",
        "--num-train-pyramids", "10",
        "--batch-size", "1",
        "--num-workers", "2",
        "--num-parallel-scales", "7",
        "--nproc-per-node", "2",
        "--lr-d", "1e-4",
        "--lr-g", "5e-4",
        "--lr-patience", "99999",
        "--discriminator-steps", "3",
        "--scale0-disc-steps-multiplier", "2",
        "--scale0-loss-multiplier", "1.5",
        "--scale0-noise-amp", "1.5",
        "--generator-steps", "3",
        "--well-loss-penalty", "1.0",
        "--facies-rec-loss-penalty", "1.5",
        "--rec-rock-physics-loss-penalty", "1.0",
        "--tv-loss-penalty", "1.0",
        "--elastic-loss-penalty", "1.0",
        "--physics-loss-penalty", "1.0",
        "--dz-pixel", "1.0",
        "--wavelet-f-peak", "8.0",
        "--wavelet-dt", "0.001",
        "--gradient-loss-penalty", "0.1",
        "--diversity-loss-penalty", "2.0",
        "--adversarial-loss-penalty", "1.5",
        "--grad-clip-norm", "1.0",
        "--num-diversity-samples", "3",
        "--gp-interval", "2",
        "--min-noise-amp", "0.3",
        "--checkpoint-interval", "100"
      ]
    },
    {
      "name": "Python: Experiments (Generate + Comparisons)",
      "type": "debugpy",
      "request": "launch",
      "module": "experiments",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "OMP_NUM_THREADS": "1",
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONEXECUTABLE": "${workspaceFolder}/.venv/bin/python",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "FG_INSTRUMENT_LOKY": "1",
        "PYTHONWARNINGS": "ignore::UserWarning",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "NCCL_P2P_LEVEL": "NVL",
        "NCCL_ALGO": "Ring",
        "NCCL_PROTO": "Simple",
        "NCCL_DEBUG": "WARN",
        "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1"
      },
      "args": [
        "--skip-training",
        "--model-paths",
        "outputs/experiments/wells_seismic",
        "outputs/experiments/wells_only",
        "outputs/experiments/seismic_only",
        "outputs/experiments/unconditional",
        "--use-rock-physics",
        "--input-path", "data",
        "--output-path", "outputs/experiments",
        "--embedding-methods", "isomap", "mds", "tsne", "umap",
        "--embedding-data", "facies", "rock_physics",
        "--num-iter", "100",
        "--nproc-per-node", "2",
        "--how-many", "1000",
        "--no-tensorboard"
      ]
    }
  ],
  "inputs": [
    {
      "id": "howMany",
      "type": "promptString",
      "description": "How many facies to generate?",
      "default": "10"
    }
  ]
}
